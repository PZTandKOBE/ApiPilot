# --------------------------------------------------------------------------- #
# Secrets
# --------------------------------------------------------------------------- #
# The backend reads its database credentials and DEEPSEEK_API_KEY from here.
# Never commit it: backend/.gitignore has the same rule, this is the belt to
# that pair of braces.
.env
.env.*
!.env.example
*.local

# --------------------------------------------------------------------------- #
# Node / package manager caches
# --------------------------------------------------------------------------- #
# A local npm cache lives in the repository root (about 100 MB of tarballs and
# debug logs). It is an artifact of the machine, not of the project.
.npm-cache/
.pnpm-store/
.yarn/cache/
node_modules/
dist/
dist-ssr/
coverage/
*.tsbuildinfo

# Deployment copy of the Vite build output; never commit generated files.
/frontend/Frontend/

# --------------------------------------------------------------------------- #
# Python
# --------------------------------------------------------------------------- #
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --------------------------------------------------------------------------- #
# Editors and operating systems
# --------------------------------------------------------------------------- #
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.suo
*.sw?

# --------------------------------------------------------------------------- #
# Logs and scratch output
# --------------------------------------------------------------------------- #
*.log
logs/
*.tmp
*.bak

# --------------------------------------------------------------------------- #
# Local-only development material (not part of the public product)
# --------------------------------------------------------------------------- #
# The DSH design skill is a local junction; the product does not depend on it.
/.agents/skills/taste-skill/

# Internal progress, contracts and backup snapshots kept only on this machine.
/docs/PROJECT_PROGRESS.md
/docs/agent-pipeline-contract.md
/docs/identity-access-contract.md
/docs/backups/
/backend/dosc/agent-pipeline-contract.md
/backend/dosc/ai-api-testing-agent-database-schema-v1.md
/backend/test_main.http
/frontend/docs/phase-6-architecture.md
/frontend/docs/phase-6.2-backend-rest-contract.md
