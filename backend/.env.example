# ApiPilot backend configuration.
# Copy this file to .env and replace every placeholder.
# NEVER commit .env or real provider/database secrets.

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=your_database

# Optional model provider
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# self_hosted (default) keeps Guest Session behavior.
# official_cloud requires accounts by default; AUTH_OFFICIAL_GUEST_ENABLED can
# explicitly opt into a server-limited guest experience.
DEPLOYMENT_MODE=self_hosted

AUTH_PUBLIC_BASE_URL=http://127.0.0.1:8000
AUTH_FRONTEND_BASE_URL=http://127.0.0.1:5173
# Generate a long random value, for example with a password manager.
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
# Use true behind HTTPS in production. Set false only for local HTTP testing.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=1209600
AUTH_STATE_TTL_SECONDS=600

# GitHub OAuth App (read:user only). Callback must match exactly.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback/github

# Google OAuth Web client (openid email profile). Redirect must match exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback/google
GOOGLE_OIDC_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration

# Official-cloud guest experience. Default is off for a cost-safe deployment.
# Local development may set this to true; the limits below are enforced by the backend.
AUTH_OFFICIAL_GUEST_ENABLED=false
AUTH_OFFICIAL_GUEST_MAX_PROJECTS=3
AUTH_OFFICIAL_GUEST_MAX_RUNS=10
AUTH_OFFICIAL_GUEST_MAX_AGENT_TASKS=1
AUTH_OFFICIAL_GUEST_DAILY_AGENT_TASKS=10

CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
